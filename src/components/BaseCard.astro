---
import { Image } from "astro:assets";
import Card from "@components/temple/Card.astro";
import type { PostData } from "@interfaces/data";

const { title, image } = Astro.props as PostData;
---

<Card>
  <div id="image-container">
    {image && <Image src={image} width="960" height="540" alt={title} loading="lazy" decoding="async" />}
  </div>
  <div class="p-4 sm:p-6">
    <slot />
  </div>
</Card>
